# ─── Database ──────────────────────────────────────────────────────────────
# Shares the dochub Postgres instance; OpsHub uses its own `opshub` schema
# managed by Prisma's multi-schema feature. The user/db are dochub's; the
# `?schema=opshub` directive scopes Prisma operations to our schema.
DATABASE_URL=postgresql://dochub:CHANGE_ME@db:5432/dochub?schema=opshub

# ─── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://opshub.pcc2k.com
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# ─── Entra SSO (shared with DocHub — same app reg, plus opshub's redirect URI) ─
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── Cross-app BFF (Phase 1+) ──────────────────────────────────────────────
# Outbound to TicketHub
TICKETHUB_BASE_URL=https://tickethub.pcc2k.com
OP_BFF_SECRET=GENERATE_WITH_openssl_rand_-hex_32
# Outbound to DocHub (Phase 1+ only, unused in Phase 0)
DOCHUB_BASE_URL=https://dochub.pcc2k.com
OP_BFF_SECRET_DH=GENERATE_WITH_openssl_rand_-hex_32

# ─── Inbound (Phase 2+ — agent → OpsHub) ───────────────────────────────────
OPSHUB_AGENT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
